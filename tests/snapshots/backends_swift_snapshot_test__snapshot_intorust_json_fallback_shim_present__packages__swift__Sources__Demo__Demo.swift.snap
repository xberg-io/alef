// Generated by alef. Do not edit by hand.
// swift-format-ignore-file

import Foundation
import RustBridge
/// Generic metadata bag.
public struct Metadata: Codable, Sendable, Hashable {
    public let kind: String
    public let attrs: [String: String]
    public init(kind: String, attrs: [String: String]) {
        self.kind = kind
        self.attrs = attrs
    }
}

// MARK: - Internal FFI conversions for Metadata
internal extension Metadata {
    init(_ rb: RustBridge.MetadataRef) throws {
        self.kind = rb.kind().toString()
        self.attrs = try JSONDecoder().decode([String: String].self, from: ((rb.attrs().toString()).data(using: .utf8) ?? Data("null".utf8)))
    }

    func intoRust() throws -> RustBridge.Metadata {
        let data = try JSONEncoder().encode(self)
        let json = String(data: data, encoding: .utf8) ?? "{}"
        return try alefBridgedCall { try RustBridge.metadataFromJson(json) }
    }
}

public typealias MetadataRef = RustBridge.MetadataRef

public typealias MetadataRefMut = RustBridge.MetadataRefMut

/// Converts an error that the Rust bridge throws into the typed Swift error. Any other error
/// passes through unchanged.
func alefTypedError(_ error: Error) -> Error {
    return error
}

/// Runs a call into the Rust bridge and throws the typed Swift error when the call fails.
func alefBridgedCall<T>(_ body: () throws -> T) throws -> T {
    do {
        return try body()
    } catch {
        throw alefTypedError(error)
    }
}

/// Runs an `async` call into the Rust bridge and throws the typed Swift error when the call fails.
func alefBridgedCallAsync<T>(_ body: () async throws -> T) async throws -> T {
    do {
        return try await body()
    } catch {
        throw alefTypedError(error)
    }
}

// MARK: - From-JSON Helpers
// Public helpers that decode JSON into first-class Swift types.
// First-class struct types (Codable) use JSONDecoder directly.
// Opaque RustBridge types forward to RustBridge.

public func metadataFromJson(_ json: String) throws -> Metadata {
    let data = json.data(using: .utf8) ?? Data()
    return try JSONDecoder().decode(Metadata.self, from: data)
}
// swift-bridge opaque type used across Task.detached boundaries — Rust type is Send + Sync.
extension RustBridge.Metadata: @unchecked Sendable {}
