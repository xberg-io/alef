// Generated by alef. Do not edit by hand.
// alef:handle-abi:1

const std = @import("std");
pub const c = @cImport(@cInclude("demo.h"));

/// Free a string allocated by the FFI layer.
/// Free a string allocated by the FFI layer.
/// The pointer must have been returned by a `demo_*` C function.
/// Do NOT call this twice on the same pointer.
pub fn _free_string(ptr: [*c]u8) void {
    c.demo_free_string(ptr);
}

/// Binding-owned copy of the last error message captured by
/// `_capture_error_message`. Freed and replaced each time a new error is
/// captured; outlives the deferred FFI calls that clear the underlying
/// thread-local state in the FFI layer.
threadlocal var _captured_error: ?[]u8 = null;

/// Retrieve the last error message captured by `_error_with_message`, if any.
/// Returns a slice into binding-owned storage, valid until the next captured
/// error overwrites it.
pub fn _last_error() ?[]const u8 {
    return _captured_error;
}

/// Copy the FFI layer's current error message into binding-owned storage.
/// Must run before any deferred `_free` call: every `demo_*` FFI entry point
/// clears the thread-local error state on entry (`catch_ffi_panic` opens with
/// `clear_last_error()`), so a `_free` invoked between the failing call and this
/// capture would wipe the message before it could be read.
fn _capture_error_message() void {
    const _code = c.demo_last_error_code();
    if (_code == 0) return;
    const _ctx = c.demo_last_error_context();
    if (_ctx == null) return;
    const _msg = std.mem.sliceTo(_ctx, 0);
    if (_captured_error) |_old| std.heap.c_allocator.free(_old);
    _captured_error = std.heap.c_allocator.dupe(u8, _msg) catch null;
}

/// Map the last FFI error to a typed error.
/// No declared variant carries a stable numeric FFI taxonomy code
/// (`#[alef(error_code = N)]`), so no specific variant can be
/// substantiated: every failure maps to `error.UnknownFfiError`.
inline fn _error_with_message(comptime E: type) E {
    _capture_error_message();
    return error.UnknownFfiError;
}

/// Errors emitted by demo operations.
pub const DemoError = error{
    InvalidInput,
    ProcessingFailed,
    OutOfMemory,
    UnknownFfiError,
};

/// A demo configuration struct.
pub const Config = struct {
    value: i32,
    label: []const u8,
    tag: ?[]const u8,
};

/// Processing status.
pub const Status = enum {
    /// Active state.
    active,
    /// Inactive state.
    inactive,
};

/// Process input and return a result.
pub fn process(input: []const u8, count: u32) DemoError![]u8 {
    const input_z = try std.fmt.allocPrintSentinel(
        std.heap.c_allocator, "{s}", .{input}, 0);
    defer std.heap.c_allocator.free(input_z);
    const _result = c.demo_process(input_z, count);
    if (c.demo_last_error_code() != 0) {
        return _error_with_message(DemoError);
    }
    if (_result == null) {
        return _error_with_message(DemoError);
    }
    const _result_len = c.demo_process_len(input_z, count);
    return blk: {
        if (_result == null) return error.UnknownFfiError;
        const slice = _result[0.._result_len];
        defer _free_string(_result);
        const owned = try std.heap.c_allocator.dupe(u8, slice);
        break :blk owned;
    }
;
}
