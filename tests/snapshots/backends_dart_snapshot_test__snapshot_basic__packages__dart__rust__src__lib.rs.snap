/// Process input and return a result.
pub fn process(input: String, count: i64) -> Result<String, AlefBridgeError> {
    demo::process(input, u32::try_from(count).map_err(|_| "parameter 'count' must be between 0 and u32::MAX".to_string())?).map(|v| v.to_string()).map_err(AlefBridgeError::from)
}

