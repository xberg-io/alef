import Foundation
import XCTest

struct NativeString {
    let value: String
    func toString() -> String { value }
}

enum RustBridge {
    struct PacketRef {
        let value: String
        let absent: Bool
        func required() -> NativeString { NativeString(value: value) }
        func nullable() -> NativeString? { absent ? nil : NativeString(value: value) }
        func legacy() -> NativeString? { absent ? nil : NativeString(value: value) }
        func requiredValue() throws -> BodyValue { .plainValue(field0: value) }
        func nullableValue() throws -> BodyValue? { absent ? nil : .plainValue(field0: value) }
        func legacyValue() throws -> BodyValue? { absent ? nil : .plainValue(field0: value) }
    }
    struct StructuralPacketRef {
        let value: String
        let absent: Bool
        func required() -> NativeString { NativeString(value: value) }
        func nullable() -> NativeString { NativeString(value: absent ? "null" : value) }
        func legacy() -> NativeString? { absent ? nil : NativeString(value: value) }
    }
}

