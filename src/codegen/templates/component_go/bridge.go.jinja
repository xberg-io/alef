    if !valid{{ loop.index }} { return 1 }
{% if param.kind == "string" %}
    if !utf8.Valid({{ param.name }}Bytes) { return 1 }
    {{ param.name }}Value := string({{ param.name }}Bytes)
{% else %}
    {{ param.name }}Value := {{ param.name }}Bytes
{% endif %}
{% elif param.kind == "bool" %}
    if {{ param.name }} > 1 { return 1 }
    {{ param.name }}Value := {{ param.name }} != 0
{% else %}
    {{ param.name }}Value := {{ param.go }}({{ param.name }})
{% endif %}
{% endfor %}
    implementation := cgo.Handle(C.alef_go_handle(instance)).Value().({{ contract.name }})
    {% if method.kind != "unit" %}result{% if method.fallible %}, err{% endif %} := {% elif method.fallible %}err := {% endif %}implementation.{{ method.name }}({% for param in method.params %}{{ param.name }}Value{% if not loop.last %}, {% endif %}{% endfor %})
{% if method.fallible %}
    if err != nil { *outError = alefBuffer([]byte(err.Error())); return 3 }
{% endif %}
{% if method.kind == "bytes" %}
