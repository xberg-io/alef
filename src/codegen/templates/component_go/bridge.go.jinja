//export AlefGo{{ contract.name }}_LifecycleCreate
func AlefGo{{ contract.name }}_LifecycleCreate(outInstance *unsafe.Pointer, outError *C.AlefComponentOwnedBuffer) (status C.AlefComponentStatus) {
    if outInstance == nil || outError == nil { return 1 }
    *outInstance = nil
    *outError = C.AlefComponentOwnedBuffer{}
    defer alefRecover(&status, outError)
    implementation := {{ contract.constructor }}()
    if implementation == nil { *outError = alefBuffer([]byte("component constructor returned nil")); return 3 }
    handle := cgo.NewHandle(implementation)
    context := C.alef_go_context(C.uintptr_t(handle))
    if context == nil { handle.Delete(); *outError = alefBuffer([]byte("allocating component context failed")); return 3 }
    *outInstance = context
    return 0
}

//export AlefGo{{ contract.name }}_LifecycleDestroy
func AlefGo{{ contract.name }}_LifecycleDestroy(instance unsafe.Pointer) {
    if instance == nil { return }
    cgo.Handle(C.alef_go_handle(instance)).Delete()
    C.free(instance)
}
