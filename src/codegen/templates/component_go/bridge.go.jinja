func alefBuffer(data []byte) C.AlefComponentOwnedBuffer {
    if len(data) == 0 { return C.AlefComponentOwnedBuffer{} }
    return C.alef_go_buffer(C.CBytes(data), C.size_t(len(data)))
}

func alefRecover(status *C.AlefComponentStatus, outError *C.AlefComponentOwnedBuffer) {
    if cause := recover(); cause != nil {
        *status = 3
        *outError = alefBuffer([]byte(fmt.Sprintf("component panicked: %v", cause)))
    }
}

func alefInput(ptr unsafe.Pointer, length C.size_t) ([]byte, bool) {
    if uint64(length) > uint64(^uint(0) >> 1) || (length != 0 && ptr == nil) { return nil, false }
    return append([]byte(nil), unsafe.Slice((*byte)(ptr), int(length))...), true
}

