{% if not has_error %}
// This method's Rust signature is infallible, so a host failure cannot
// propagate. Log it via `tracing::warn!` instead of eprintln! (invisible in
// browsers) — consumers that want browser console output can wire up a wasm
// tracing subscriber (e.g. tracing-wasm) on top of this crate's tracing events.
{% endif %}
let key = wasm_bindgen::JsValue::from_str("{{ js_name }}");
let has_method = js_sys::Reflect::has(&self.inner, &key).unwrap_or(false);
if !has_method {
{% if has_error %}
    return Err({{ error_expr }});
{% else %}
    tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", "host method is missing; returning default");
    return Default::default();
{% endif %}
}

{% if has_error %}
let func_val = js_sys::Reflect::get(&self.inner, &key)
    .map_err(|_| {{ error_get_method }})?;
{% else %}
let func_val = match js_sys::Reflect::get(&self.inner, &key) {
    Ok(f) => f,
    Err(e) => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", error = ?e, "failed to get host method; returning default");
        return Default::default();
    }
};
{% endif %}

{% if has_error %}
let func: js_sys::Function = func_val.dyn_into()
    .map_err(|_| {{ error_dyn_into }})?;
{% else %}
let func: js_sys::Function = match func_val.dyn_into() {
    Ok(f) => f,
    Err(_) => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", "host method is not a function; returning default");
        return Default::default();
    }
};
{% endif %}

// Build args array
let args = js_sys::Array::new();
{% for param in params %}
args.push(&{{ param }});
{% endfor %}

// Call the function
{% if has_error %}
let result = func.apply(&self.inner, &args)
    .map_err(|_| {{ error_apply }})?;
{% else %}
let result = match func.apply(&self.inner, &args) {
    Ok(r) => r,
    Err(e) => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", error = ?e, "host callback threw; returning default");
        return Default::default();
    }
};
{% endif %}

// Convert result
{% if return_unit %}
{% if has_error %}
Ok(())
{% else %}
()
{% endif %}
{% elif return_string %}
{% if has_error %}
result.as_string()
    .ok_or_else(|| {{ error_string_conv }})
{% else %}
match result.as_string() {
    Some(s) => s,
    None => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", "host returned a non-string value; returning default");
        Default::default()
    }
}
{% endif %}
{% elif return_bool %}
// Convert JS boolean to Rust bool
{% if has_error %}
result.as_bool()
    .ok_or_else(|| {{ error_result_conv }})
{% else %}
match result.as_bool() {
    Some(b) => b,
    None => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", "host returned a non-boolean value; returning default");
        Default::default()
    }
}
{% endif %}
{% elif return_number %}
// Convert JS number to {{ ret_ty }}
{% if has_error %}
result.as_f64()
    .map(|n| n as {{ ret_ty }})
    .ok_or_else(|| {{ error_result_conv }})
{% else %}
match result.as_f64() {
    Some(n) => n as {{ ret_ty }},
    None => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", "host returned a non-numeric value; returning default");
        Default::default()
    }
}
{% endif %}
{% elif return_enum %}
// Convert bare enum string (non-JSON) to {{ ret_ty }}
{% if has_error %}
result.as_string()
    .ok_or_else(|| {{ error_result_conv }})
    .and_then(|s| serde_json::from_str::<{{ ret_ty }}>(&format!("\"{}\"", s)).map_err(|e| {{ error_deser }}))
{% else %}
match result.as_string() {
    Some(s) => match serde_json::from_str::<{{ ret_ty }}>(&format!("\"{}\"", s)) {
        Ok(v) => v,
        Err(e) => {
            tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", error = %e, "host returned an unparseable value; returning default");
            Default::default()
        }
    },
    None => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", "host returned a non-string value; returning default");
        Default::default()
    }
}
{% endif %}
{% else %}
// Convert JS result to {{ ret_ty }}
{% if has_error %}
result.as_string()
    .ok_or_else(|| {{ error_result_conv }})
    .and_then(|s| serde_json::from_str::<{{ ret_ty }}>(&s).map_err(|e| {{ error_deser }}))
{% else %}
match result.as_string() {
    Some(s) => match serde_json::from_str::<{{ ret_ty }}>(&s) {
        Ok(v) => v,
        Err(e) => {
            tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", error = %e, "host returned an unparseable value; returning default");
            Default::default()
        }
    },
    None => {
        tracing::warn!(wrapper = "{{ wrapper }}", method = "{{ js_name }}", "host returned a non-string value; returning default");
        Default::default()
    }
}
{% endif %}
{% endif %}
