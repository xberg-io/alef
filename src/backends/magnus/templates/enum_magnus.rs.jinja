{# Data enum definition with IntoValue/TryConvert via JSON #}
{% if has_data %}
{% set typed_variants = variants|selectattr("typed_newtype")|list %}
#[derive(Clone{% if not has_sensitive %}, Debug{% endif %}, serde::Serialize, serde::Deserialize)]
{% if native_payload %}#[magnus::wrap(class = "{{ module_name }}::{{ enum_name }}")]
{% endif %}
{% if serde_tag %}#[serde(tag = "{{ serde_tag }}"{% if serde_content %}, content = "{{ serde_content }}"{% endif %})]
{% endif %}{% if serde_untagged %}#[serde(untagged)]
{% endif %}{% if serde_rename_all %}#[serde(rename_all = "{{ serde_rename_all }}")]
{% endif %}pub enum {{ enum_name }} {
{% for variant in variants %}
{% if variant.serde_rename %}    #[serde(rename = "{{ variant.serde_rename }}")]
{% endif %}{% if variant.fields %}
{%- if variant.emits_as_tuple %}    {{ variant.name }}({% for field in variant.fields %}{{ field.field_type }}{{ ", " if not loop.last }}{% endfor %}),
{%- else %}    {{ variant.name }} { {% for field in variant.fields %}{% if field.flatten_newtype %}#[serde(flatten)] {% endif %}{% if field.serde_rename_literal %}#[serde(rename = {{ field.serde_rename_literal }})] {% endif %}{% if field.serde_alias_literal %}#[serde(alias = {{ field.serde_alias_literal }})] {% endif %}{{ field.name }}: {{ field.field_type }}{{ ", " if not loop.last }}{% endfor %} },
{%- endif %}
{% else %}    {{ variant.name }},
{% endif %}{% endfor %}}

{% if has_default %}impl Default for {{ enum_name }} {
    fn default() -> Self { Self::{{ default_variant }}{{ first_variant_default }} }
}
{% endif %}

{% if not native_payload %}{% if serde_tag and typed_variants %}
// Reconstruct the generated Data variant class instead of a plain Hash, keeping
// IntoValue symmetric with TryConvert (which accepts those variant classes).
// Falls back to the JSON shape when the Ruby classes are not loaded.
impl {{ enum_name }} {
    fn tagged_ruby_variant(&self, handle: &Ruby) -> Option<magnus::Value> {
        match self {
{%- for variant in variants %}
{%- if variant.typed_newtype and variant.fields and (variant.fields|length) == 1 %}
{%- if variant.emits_as_tuple %}
            {{ enum_name }}::{{ variant.name }}(payload) => {
{%- else %}
            {{ enum_name }}::{{ variant.name }} { {{ variant.fields[0].name }}: payload } => {
{%- endif %}
                // Resolve the variant before wrapping a payload whose Ruby class may also be absent. ~keep
                let class = handle.eval::<magnus::RClass>("{{ module_name }}::{{ enum_name }}{{ variant.name }}").ok()?;
                let payload = {% if variant.payload_boxed %}(**payload){% else %}(*payload){% endif %}.clone();
                let value = <{{ variant.payload_type }} as magnus::IntoValue>::into_value_with(payload, handle);
                class.funcall::<_, _, magnus::Value>("new", (value,)).ok()
            }
{%- endif %}
{%- endfor %}
{% if typed_variants|length < variants|length %}
            _ => None,
{% endif %}
        }
    }
}

{% endif %}impl magnus::IntoValue for {{ enum_name }} {
    fn into_value_with(self, handle: &Ruby) -> magnus::Value {
{%- if serde_tag and typed_variants %}
        if let Some(instance) = self.tagged_ruby_variant(handle) {
            return instance;
        }
{%- endif %}
        match serde_json::to_value(&self) {
            Ok(v) => json_to_ruby(handle, v),
            Err(_) => handle.qnil().into_value_with(handle),
        }
    }
}
{% endif %}

impl magnus::TryConvert for {{ enum_name }} {
    fn try_convert(val: magnus::Value) -> Result<Self, magnus::Error> {
{%- if native_payload %}
        // The native class is the only unambiguous input for a discriminator-free enum, but it is
        // not the only legitimate one: serde's own Deserialize accepts every variant's wire form,
        // so a caller holding a decoded String or Hash must keep working. Take the wrapped instance
        // when there is one, otherwise fall through to the serde reader below. ~keep
        if let Ok(wrapped) = <&Self as magnus::TryConvert>::try_convert(val) {
            return Ok(wrapped.clone());
        }
{%- endif %}
{%- if serde_tag %}
        // Generated Data variants carry native DTOs, not JSON-compatible display strings.
        let class_name: Option<String> = val.class().funcall("name", ())?;
{%- for variant in variants %}
{%- if variant.typed_newtype %}
        if class_name.as_deref() == Some("{{ module_name }}::{{ enum_name }}{{ variant.name }}") {
            let payload: {{ variant.payload_type }} = val.funcall("value", ())?;
            return Ok(Self::{{ variant.name }}{% if variant.emits_as_tuple %}({% if variant.payload_boxed %}Box::new(payload){% else %}payload{% endif %}){% else %} { _0: {% if variant.payload_boxed %}Box::new(payload){% else %}payload{% endif %} }{% endif %});
        }
{%- endif %}
{%- endfor %}
{%- endif %}
        // For data enums with fields (e.g., PageAction), try to deserialize from JSON first.
        // For unit enums or when passed as a string, fall back to string-based conversion.
        let json_str: String = if let Ok(s) = <String as magnus::TryConvert>::try_convert(val) {
            s
        } else {
            val.funcall::<_, _, String>("to_json", ()).map_err(|e| {
                magnus::Error::new(unsafe { Ruby::get_unchecked() }.exception_type_error(),
                    format!("no implicit conversion into {{ enum_name }}: {}", e))
            })?
        };
        // Try deserializing as JSON first (handles JSON strings like "\"markdown\"" or "{\"click\":{\"selector\":\"...\"}}\"")
        // For internally-tagged enums, a bare variant string is wrapped as {"<tag>": value}.
        // If that fails, try treating it as a plain string value and wrap in quotes
        // If both fail, try as Custom variant (for untagged enum support)
        serde_json::from_str(&json_str)
{%- if serde_tag %}
            .or_else(|_| serde_json::from_value(serde_json::json!({ "{{ serde_tag }}": json_str })))
{%- endif %}
            .or_else(|_| serde_json::from_str(&format!("\"{json_str}\"")))
            .or_else(|_| {
                // Try as a JSON string for Custom variant (untagged enums accept any remaining value)
                match serde_json::to_value(&json_str) {
                    Ok(val) => serde_json::from_value(val),
                    Err(e) => Err(e),
                }
            })
            .map_err(|e| magnus::Error::new(unsafe { Ruby::get_unchecked() }.exception_type_error(), e.to_string()))
    }
}

