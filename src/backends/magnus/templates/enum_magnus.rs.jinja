unsafe impl TryConvertOwned for {{ enum_name }} {}

{% if native_payload %}
impl {{ enum_name }} {
{% for variant in variants %}
    pub fn from_{{ variant.snake_name }}(value: {{ variant.payload_type }}) -> Self {
        Self::{{ variant.name }}({% if variant.payload_boxed %}Box::new(value){% else %}value{% endif %})
    }
    pub fn {{ variant.snake_name }}(&self) -> Option<{{ variant.payload_type }}> {
        match self {
            Self::{{ variant.name }}(value) => Some({% if variant.payload_boxed %}(**value).clone(){% else %}value.clone(){% endif %}),
            _ => None,
        }
    }
{% endfor %}
}
{% endif %}

{%- if has_data %}
{# Variant accessor methods for internally-tagged data enums #}
{%- if serde_tag and not native_payload %}
impl {{ enum_name }} {
{%- for variant in variants %}
{%- if variant.fields | length == 1 and variant.fields[0].name == "_0" %}
    pub fn {{ variant.snake_name }}(&self) -> Option<&{{ variant.payload_type }}> {
        match self {
{% if variant.emits_as_tuple %}            Self::{{ variant.name }}(_0) => Some({% if variant.payload_boxed %}&**_0{% else %}_0{% endif %}),
{% else %}            Self::{{ variant.name }} { _0 } => Some({% if variant.payload_boxed %}&**_0{% else %}_0{% endif %}),
{% endif %}
            _ => None,
        }
    }
{%- endif %}
{%- endfor %}
}
{%- endif %}
{%- endif %}

