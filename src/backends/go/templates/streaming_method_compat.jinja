// {{ method_name }} starts the stream using a background context.
// Range over Chan on the result, then read Err: a stream that ends in an error closes the
// channel the same way as a clean end of stream.
// Use {{ method_name }}WithContext to cancel a stream before it ends.
func ({{ receiver_name }} *{{ receiver_type }}) {{ method_name }}({{ params }}) (*{{ stream_type_name }}, error) {
	return {{ receiver_name }}.{{ method_with_context_name }}(context.Background(){% if param_args %}, {{ param_args }}{% endif %})
}
