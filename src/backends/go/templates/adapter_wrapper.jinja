// Range over Chan on the result, then read Err: a stream that ends in an error closes the
// channel the same way as a clean end of stream.
// Use {{ go_func_with_context_name }} to cancel a stream before it ends.
func {{ go_func_name }}({{ params }}) ({{ context_return_type }}) {
	return {{ go_func_with_context_name }}({{ compatibility_args }})
}

