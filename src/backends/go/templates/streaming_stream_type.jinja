// Chan returns the item channel. Range over it to completion, then check Err.
//
// Cancelling the context passed to {{ receiver_type }}.{{ method_name }}WithContext aborts a blocked
// native read and unblocks the forwarding goroutine's next send, so it exits and closes the channel
// on its own. After cancelling, keep ranging over Chan (it will close promptly) instead of
// abandoning it, then read Err.
func (s *{{ stream_type_name }}) Chan() <-chan {{ item_type }} { return s.ch }

// Err returns the error that ended the stream: nil on a clean end-of-stream, or the caller's
// ctx.Err() when the context passed to {{ receiver_type }}.{{ method_name }}WithContext was cancelled.
//
// Err is only safe to read after ranging over Chan to completion: the channel close is what
// makes the producing goroutine's write to err visible to the caller. This still holds after
// cancelling the context -- cancellation unblocks the goroutine, it does not publish err by
// itself. Calling Err concurrently with ranging over Chan is a data race.
func (s *{{ stream_type_name }}) Err() error { return s.err }
