#[pyfunction]
#[pyo3(name = "{{ host_symbol }}")]
pub fn _alef_{{ clear_fn }}(py: Python<'_>) -> PyResult<()> {
    py.detach(|| {
{% if preserve_host_error %}
        {{ host_path }}().map_err(|e| {
            AlefPythonRegistryError(&e).host_exception().unwrap_or_else(|| {
                pyo3::exceptions::PyRuntimeError::new_err(format!("{}", e))
            })
        })
{% else %}
        {{ host_path }}()
            .map_err(|e| pyo3::exceptions::PyRuntimeError::new_err(format!("{}", e)))
{% endif %}
    })
}
