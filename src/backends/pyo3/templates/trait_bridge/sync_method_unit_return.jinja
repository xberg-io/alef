Python::attach(|py| {
    let obj = self.inner.bind(py);
    py.import("contextvars")
        .and_then(|m| m.call_method0("copy_context"))
        .and_then(|ctx| {
{% if host_alias %}
            let bound_method = match obj.getattr("{{ method_name }}") {
                Ok(method) => method,
                Err(error) if error.is_instance_of::<pyo3::exceptions::PyAttributeError>(py) => {
                    match py.import("inspect")?.call_method1("getattr_static", (obj, "{{ method_name }}")) {
                        Ok(_) => return Err(error),
                        Err(absent) if absent.is_instance_of::<pyo3::exceptions::PyAttributeError>(py) => {
                            obj.getattr("{{ host_alias }}")?
                        }
                        Err(error) => return Err(error),
                    }
                }
                Err(error) => return Err(error),
            };
{% else %}
            let bound_method = obj.getattr("{{ method_name }}")?;
{% endif %}
            ctx.call_method1("run", ({{ run_args }}))
        })
        .map(|_| ())
{% if has_error %}
        .map_err(|e| {{ error_expr }})
{% else %}
        .unwrap_or_else(|e| {
            // This method's Rust signature is infallible, so a host exception
            // cannot propagate. Log it before discarding — a silently dropped
            // callback failure is invisible to the caller.
            tracing::warn!(
                wrapper = "{{ wrapper }}",
                method = "{{ method_name }}",
                error = %e,
                "host callback raised; ignoring"
            );
        })
{% endif %}
})
