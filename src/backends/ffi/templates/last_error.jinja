{% endif %}
#[unsafe(no_mangle)]
pub unsafe extern "C" fn {{ field.accessor }}() -> {{ field.c_type }} {
{% if field.kind == "text" %}
    catch_ffi_panic_preserving_error({{ field.fallback_expression }}, || LAST_ERROR_{{ field.upper }}.with_borrow(|value| {
