void _alefCheckU64Argument(dynamic value, dynamic shape, [Set<Object>? visited]) {
  if (value == null || shape == null) return;
  if (shape == 'u64') {
    if (value.isNegative || value.bitLength > 64) {
      throw RangeError('u64 unsigned value must be between 0 and 18446744073709551615: $value');
    }
    return;
  }
  final seen = visited ?? Set<Object>.identity();
  if (shape is List) {
    if (shape[0] == 'list') {
      for (final entry in value) {
        _alefCheckU64Argument(entry, shape[1], seen);
      }
    } else {
      for (final entry in value.entries) {
        _alefCheckU64Argument(entry.key, shape[1], seen);
        _alefCheckU64Argument(entry.value, shape[2], seen);
      }
    }
    return;
  }
  if (!seen.add(value)) return;
