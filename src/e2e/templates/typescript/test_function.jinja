{# TypeScript test case (it() block) template

   Context variables:
   - test_name: sanitized test name
   - description: fixture description with escaped quotes
   - async_kw: "async " (or empty string)
   - client_setup: client instantiation code (or empty string)
   - setup_lines: array of setup statement strings
   - call_expr: function call expression
   - has_usable_assertion: bool
   - void_not_error: bool — returns_void call whose only meaningful check is `not_error`;
     wraps call_expr in expect(...).resolves.not.toThrow() (async calls) or
     expect(() => ...).not.toThrow() (sync calls) so the check is a real, visible
     assertion instead of a bare, unbound call statement
   - call_is_async: bool — the IR/config-derived authority for whether call_expr resolves a
     Promise; selects which void_not_error wrapper shape to emit (a sync call has no Promise
     for `.resolves` to unwrap, so `expect()` would throw TypeError at runtime, and `.resolves`
     on a non-Promise fails to type-check under strict TypeScript). Never forced by
     trait-bridge presence — a synchronous trait method call must still select the sync
     wrapper. `await_kw` is allowed to differ from this value (it may still force `await` for
     trait-bridge calls, since `await` on a non-Promise is a legal no-op).
   - result_var: result variable name
   - await_kw: "await " (or empty string)
   - assertions_body: string containing all rendered assertions
   - expects_error: bool
   - error_value_regex: optional string — JS regex literal (e.g. "/foo\(bar\)/")
       matching a declared error assertion value. Checked against EITHER the
       thrown error's message OR its `name`. Absent means "throws anything".
   - error_property_object: optional string - the body of an object literal holding the properties
       the thrown error must carry (`kind` for a declared variant, `statusCode` for an
       `error.status_code` assertion), compared with `expect.objectContaining`
   - error_property_conditions: the same properties as ` && error?.kind === ".."` conditions, spliced
       into the regex predicate when a declared message value is checked as well
   - error_skip_line: optional string — a pre-rendered `//`-prefixed registered-skip comment
       for a declared error value naming a real error variant this backend cannot
       substantiate. Mutually exclusive with error_value_regex: never both set.
   - is_streaming_error_call: bool — streaming function called with error fixture;
       drain with `for await` so the lazy NAPI stream surfaces the error
   - skip_reason: optional string reason for skipping the test
   - refusal_body: optional string — the rendered skip markers plus alef's reason, emitted as an
       `it.skip` body when the fixture declared assertions and none of them rendered a runnable
       expectation. Carries the markers so the refusal is not a silent skip.
   - bridge_cleanup: optional string for async trait bridge dispose() calls
   - unrenderable_error_assertions: skip markers for error-path assertions this backend cannot render
#}
{% if skip_reason %}
	it.skip("{{ test_name }}: {{ description }}", () => {
		// {{ skip_reason }}
	});
{% elif refusal_body %}
	it.skip("{{ test_name }}: {{ description }} ({{ refusal_reason }})", () => {
{{ refusal_body }}
	});
{% elif expects_error %}
	it("{{ test_name }}: {{ description }}", async () => {
{% if client_setup %}
		{{ client_setup }}
{% endif %}
		await expect(async () => {
{% for line in setup_lines %}
			{{ line }}
{% endfor %}
{% if is_streaming_error_call %}
			const _stream = await {{ call_expr }};
{% if lang == "wasm" %}
			while (true) {
				const _ = await _stream.next();
				if (_ == null) break;
				/* drain to surface HTTP errors */
			}
{% else %}
			for await (const _ of _stream) {
				/* drain to surface HTTP errors */
			}
{% endif %}
{% else %}
			await {{ call_expr }};
{% endif %}
{% if error_value_regex %}
		}).rejects.toSatisfy((error) => {
				const _message = error instanceof Error ? error.message : String(error);
				const _name = error instanceof Error ? error.name : "";
{% if error_property_conditions %}
				return ({{ error_value_regex }}.test(_message) || {{ error_value_regex }}.test(_name)){{ error_property_conditions }};
{% else %}
				return {{ error_value_regex }}.test(_message) || {{ error_value_regex }}.test(_name);
{% endif %}
			});
{% elif error_property_object %}
		}).rejects.toEqual(expect.objectContaining({ {{ error_property_object }} }));
{% else %}
		}).rejects.toThrow();
{% endif %}
{% if error_skip_line %}
{{ error_skip_line }}
{% endif %}
{% if unrenderable_error_assertions %}
{{ unrenderable_error_assertions }}
{% endif %}
{% if coverage_warning %}
{{ coverage_warning }}
{% endif %}
	}, {{ timeout_ms }});
{% else %}
	it("{{ test_name }}: {{ description }}", {{ async_kw }}() => {
{% if client_setup %}
		{{ client_setup }}
{% endif %}
{% for line in setup_lines %}
		{{ line }}
{% endfor %}
{% if void_not_error %}
{% if call_is_async %}
		await expect({{ call_expr }}).resolves.not.toThrow();
{% else %}
		expect(() => {{ call_expr }}).not.toThrow();
{% endif %}
{% elif has_usable_assertion %}
		const {{ result_var }} = {{ await_kw }}{{ call_expr }};
{% else %}
		{{ await_kw }}{{ call_expr }};
{% endif %}
{% if collect_snippet %}
		{{ collect_snippet }}
{% endif %}
{{ assertions_body }}
{% if bridge_cleanup %}
		{{ bridge_cleanup }}
{% endif %}
{% if coverage_warning %}
{{ coverage_warning }}
{% endif %}
	}, {{ timeout_ms }});
{% endif %}
