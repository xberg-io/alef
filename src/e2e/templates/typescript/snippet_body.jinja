{% if operation.kind == "show" %}{% if operation.guard_condition %}{{ body_indent }}const {{ operation.guard_binding }} = {{ operation.guard_source }};
{{ body_indent }}if ({{ operation.guard_condition }}) {
{{ body_indent }}  console.log({{ operation.expression }});
{{ body_indent }}}
{% else %}{{ body_indent }}console.log({{ operation.expression }});
{% endif %}
{% else %}{% if operation.destructure_source %}{{ body_indent }}const [{{ operation.destructure_item }}] = {{ operation.destructure_source }};
{% endif %}{{ body_indent }}for (const {{ operation.item }} of {{ operation.expression }}{% if operation.optional %} ?? []{% endif %}) {
{% for field in operation.fields %}{{ body_indent }}  console.log({{ field }});
{% endfor %}{{ body_indent }}}
{% endif %}
{% endfor %}
{% if not presentation and not returns_void %}{{ body_indent }}console.log({{ result_var }});
{% endif %}
{% if client_release %}  } finally {
    {{ client_release }}
  }
{% endif %}
{% endif %}
}

void main();
