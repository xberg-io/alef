{% if expects_error %}  try {
    await {{ call_expr }};
  } catch (error) {
{% if thrown_value_is_opaque %}    console.error(String(error));
{% else %}    if (error instanceof {{ error_type }}) {
      console.error(`${error.name}: ${error.message}`);
    }
{% endif %}  }{{ " finally {" if client_release else "" }}
{% if client_release %}    {{ client_release }}
  }
{% endif %}
{% else %}
{% if client_release %}  try {
{% endif %}
{{ body_indent }}const {{ result_var }} = await {{ call_expr }};
