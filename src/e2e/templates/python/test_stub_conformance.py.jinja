def test_public_dataclasses_forward_native_methods() -> None:
    options = importlib.import_module("{{ import_name }}.options")
    missing = [
        f"{class_name}.{name}"
        for class_name, names in FORWARDED_METHODS.items()
        for name in names
        if not callable(getattr(getattr(options, class_name, None), name, None))
    ]
    assert not missing, f"forwarded by the package generator but absent at runtime: {missing}"
