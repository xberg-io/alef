void checkEnvelope(Envelope value, String expected, bool absent) {
  require((value.optional == null) == absent, 'optional record native value');
  require(value.leaves.length == 1, 'one native nested list element');
  final leaves = [value.leaf, if (value.optional != null) value.optional!, ...value.leaves];
  require(leaves.length == (absent ? 2 : 3), 'native leaf count');
  for (final leaf in leaves) {
    require(leaf.wide is BigInt && leaf.wide.toString() == expected, 'native wide field');
    require(absent ? leaf.optionalWide == null : leaf.optionalWide is BigInt && leaf.optionalWide?.toString() == expected, 'native optional wide field');
    require(leaf.signed == -1 && leaf.narrow == 17 && leaf.word == 23, 'native non-u64 fields');
  }
}

