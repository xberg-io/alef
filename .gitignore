.polylint/

poly.local.toml

# Alef snippet validator scratch workspaces and caches ~keep
**/.alef-snippet-*/
**/.alef-cache/
**/.alef/


# insta writes these beside the committed baselines when a snapshot changes. They are
# a review artifact awaiting `cargo insta accept`, never a baseline, and committing one
# makes an unreviewed snapshot look adopted.
*.snap.new

# Sibling-session agent worktrees; never part of the repo. ~keep
.worktrees/
erl_crash.dump

